# Dependencies
node_modules/
.pnp.*
.yarn/

# Build output
dist/
dist-server/
build/
out/
*.tsbuildinfo
cdk.out/

# CDK
infra/cdk.out/
infra/cdk.out.*/
infra/cdk-outputs-*.json
# Both spellings on purpose: the trailing slash matches a real directory, and the
# bare name matches a symlink to one — which is how a git worktree borrows the
# main checkout's already-installed CDK deps instead of reinstalling 400 MB.
infra/node_modules/
infra/node_modules

# Environment
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Kiro state & cache
.kiro/state/
.kiro/cache/
.kiro/logs/

# Test
coverage/
test-results/
playwright-report/
blob-report/

# Python (scripts/ has helper modules; importing them creates bytecode caches)
__pycache__/
*.py[cod]

# Misc
*.log
npm-debug.log*

# Playwright MCP session logs
.playwright-mcp/
