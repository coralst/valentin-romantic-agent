# Dependencies
node_modules/
.pnp.*
.yarn/

# Build output
dist/
dist-server/
build/
out/
*.tsbuildinfo
cdk.out/

# CDK
infra/cdk.out/
infra/cdk.out.*/
infra/cdk-outputs-*.json
# Both spellings on purpose: the trailing slash matches a real directory, and the
# bare name matches a symlink to one — which is how a git worktree borrows the
# main checkout's already-installed CDK deps instead of reinstalling 400 MB.
infra/node_modules/
infra/node_modules

# Environment
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Kiro state & cache
.kiro/state/
.kiro/cache/
.kiro/logs/

# Kiro pr-monitoring runtime state (written by .kiro/skills/pr-monitoring)
.kiro/.pr-monitoring-*.json
.kiro/.pr-feedback-*.json
.kiro/.pr-monitor-*.log

# Claude Code
# Agent worktrees are full checkouts — never commit them.
.claude/worktrees/
# Per-machine permissions and overrides. Shared config belongs in
# .claude/settings.json, which IS committed.
.claude/settings.local.json

# Test
coverage/
test-results/
# PW_RESULTS lets a concurrent worktree run E2E without overwriting another run's
# traces, so the directory name is no longer fixed.
test-results-*/
playwright-report/
blob-report/

# Python (scripts/ has helper modules; importing them creates bytecode caches)
__pycache__/
*.py[cod]

# Misc
*.log
npm-debug.log*

# Playwright MCP session logs
.playwright-mcp/

# PowerPoint/Keynote writes a lock file beside any open .pptx and removes it on
# close — so it appears for anyone who so much as opens the deck to look at it.
~$*.pptx

# One PNG per deck slide, regenerated by `npm run deck:pptx` on the way to the
# .pptx. The .pptx IS committed; these are the intermediate frames it embeds, so
# carrying both would double the megabytes for nothing.
docs/deck-export/

# Local verification screenshots (regenerated by `npm run verify:local`)
screenshots/verify/
screenshots/demo/
screenshots/final/
# Ad-hoc bug-hunt captures. Evidence for one PR, not history worth carrying —
# attach them to the PR instead of committing a few MB of PNGs per sweep.
screenshots/bug-hunt-*/

# Throwaway session drivers. A parallel session spins up its own dev server on
# its own port and its own ad-hoc Playwright driver; those are scratch, and
# committing one means the next integration merge has to invent an OWNERSHIP row
# for it. `rehearsal.mjs` is the tracked, shared driver — add to that instead.
vite.config.*.mts
!vite.config.ts
shots-*.mjs
verify-fixes.mjs
