{
  "name": "valentin-romantic-agent",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npx tsx src/server/dev-server.ts",
    "dev:full": "npx tsx src/server/dev-server.ts & vite --open; wait",
    "smoke-test": "npx tsx scripts/smoke-test.ts",
    "verify-model": "npx tsx scripts/verify-model.ts",
    "build": "vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "test": "vitest --run",
    "ddb-local:start": "docker run -d --rm -p 8000:8000 --name valentin-ddb-local amazon/dynamodb-local -jar DynamoDBLocal.jar -inMemory -sharedDb",
    "ddb-local:stop": "docker stop valentin-ddb-local",
    "lint": "tsc --noEmit",
    "deploy:dev": "bash scripts/deploy.sh dev",
    "deploy:prod": "bash scripts/deploy.sh prod",
    "teardown": "bash scripts/teardown.sh"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1024.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1115.0",
    "@aws-sdk/client-dynamodb": "^3.1024.0",
    "@aws-sdk/client-secrets-manager": "^3.1115.0",
    "@aws-sdk/lib-dynamodb": "^3.1024.0",
    "aws-jwt-verify": "^5.2.1",
    "express": "^5.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uuid": "^11.1.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.2",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2",
    "fast-check": "^4.1.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  }
}
